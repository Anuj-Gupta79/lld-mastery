@startuml
title Class Diagram for Sort Strategy Pattern
' interfaces and classes go here
interface SortStrategy {
    +sort(data: List): List
}

class BubbleSort  {
    +sort(data: List): List
}

class QuickSort  {
    +sort(data: List): List
}

class MergeSort{
    +sort(data: List): List
}

class SortContext {
    -strategy: SortStrategy
    +setStrategy(strategy: SortStrategy): void
    +sortData(data: List): List
}

' relationships go here
SortContext --o SortStrategy
BubbleSort ..|> SortStrategy
QuickSort ..|> SortStrategy
MergeSort ..|> SortStrategy

@enduml